# ---------------------------------------------------------------------------
# Unichain Sepolia  (chain id 1301)
# ---------------------------------------------------------------------------
# Every address below was read out of v4-periphery's own broadcast records and
# then verified live on chain: the PoolManager has 24,009 bytes of code, answers
# owner(), and exposes extsload(), which is v4-specific.

UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac

# Uniswap's own test routers, already deployed there. Useful for driving a swap
# through the hook without writing your own router.
POOL_SWAP_TEST=0x9140a78c1a137c7ff1c151ec8231272af78a99a4
POOL_MODIFY_LIQUIDITY_TEST=0x5fa728c0a5cfd51bee4b060773f50554c0c8a7ab
POSITION_MANAGER=0xf969aee60879c54baaed9f3ed26147db216fd664
STATE_VIEW=0xc199f1072a74d4e905aba1a84d9a45e2546b6222

# ---------------------------------------------------------------------------
# Postmark, live on Unichain Sepolia
# ---------------------------------------------------------------------------
POSTMARK_HOOK=0xdB86D5Fd78174d6ACE2EB268DB12F29C335A10C0
FLOW_VAULT=0x0F1bf92EE0C79F7Ca5C1e30E9412aD5BFF45c7C8
SCORE_REGISTRY=0x9872b13257E958c2F7E4DcCc3F96b3C70c8e050c

# ---------------------------------------------------------------------------
# Yours
# ---------------------------------------------------------------------------
PRIVATE_KEY=
GUARDIAN=                 # optional, defaults to the deployer
TOKEN0=                   # optional, must sort below TOKEN1
TOKEN1=

# Archive RPC for the backtest. A public endpoint will NOT work - it only serves
# head-adjacent blocks. A free Alchemy or Infura key is enough.
ETH_RPC_URL=
